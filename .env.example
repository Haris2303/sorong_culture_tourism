# === Flask ===
SECRET_KEY=ganti-dengan-random-secret-key-yang-panjang
# development | production. Set ke "production" di server produksi: DEBUG otomatis
# mati (apa pun nilai FLASK_DEBUG) & cookie session jadi HTTPS-only secara default.
FLASK_ENV=development
FLASK_DEBUG=True
# Override manual cookie session HTTPS-only jika perlu (default: ikut FLASK_ENV).
# SESSION_COOKIE_SECURE=True

# === MySQL (XAMPP default) ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sorong_culture_tourism

# === Google Gemini API (dipakai untuk embedding RAG saja) ===
GEMINI_API_KEY=isi-api-key-gemini-anda
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# === Hive AI - DeepSeek (LLM utama chatbot; lihat llm_config.py) ===
# Buat Secret Key di console Hive. Jika HIVE_API_KEY kosong, chatbot memakai OpenRouter/Gemini di bawah.
# Batas default 5 request/detik. HTTP 429 = rate limit, 405 = saldo organisasi tidak cukup.
HIVE_API_KEY=
HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3
HIVE_MODEL_NAME=deepseek-ai/deepseek-v4.1-flash
# Model reasoning: "none" mematikan proses berpikir agar jawaban cepat & content tidak kosong.
# Kosongkan nilainya untuk tidak mengirim parameter ini.
HIVE_REASONING_EFFORT=none

# === OpenRouter (cadangan chat/generation chatbot) ===
# Daftar gratis & buat key di https://openrouter.ai/keys
OPENROUTER_API_KEY=isi-api-key-openrouter-anda
# Model gratis OpenRouter sering berganti/penuh. Cek yang masih ada di
# https://openrouter.ai/models?max_price=0 lalu urutkan dari yang tercepat.
# "openrouter/free" (router acak) cocok sebagai cadangan terakhir, jangan jadi
# satu-satunya model: kalau kebetulan dapat model lambat, chatbot timeout.
OPENROUTER_CHAT_MODEL=inclusionai/ling-3.0-flash-sante:free
OPENROUTER_CHAT_MODEL_FALLBACKS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,openrouter/free

# === RAG / ChromaDB ===
CHROMA_PERSIST_DIR=./data_store/chroma_db
CHROMA_COLLECTION_NAME=sorong_knowledge
KNOWLEDGE_DOCS_DIR=./data_store/knowledge_docs
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.55

# === Upload ===
UPLOAD_FOLDER=./static/uploads
MAX_CONTENT_LENGTH_MB=15
# Gambar diresize & dikonversi ke WebP otomatis (browser + server), lihat config.py
IMAGE_MAX_DIMENSION=1920
IMAGE_WEBP_QUALITY=82
MAX_GALERI_FILES=12
