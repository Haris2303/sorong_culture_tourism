# === Flask ===
SECRET_KEY=ganti-dengan-random-secret-key-yang-panjang
FLASK_ENV=development
FLASK_DEBUG=True

# === MySQL (XAMPP default) ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sorong_culture_tourism

# === Google Gemini API (dipakai untuk embedding RAG saja) ===
GEMINI_API_KEY=isi-api-key-gemini-anda
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# === OpenRouter (dipakai untuk chat/generation chatbot) ===
# Daftar gratis & buat key di https://openrouter.ai/keys
OPENROUTER_API_KEY=isi-api-key-openrouter-anda
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_CHAT_MODEL_FALLBACKS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,z-ai/glm-5.2:free,google/gemma-4-26b-a4b-it:free,qwen/qwen3.8-27b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,inclusionai/ling-3.0-flash-vl:free

# === RAG / ChromaDB ===
CHROMA_PERSIST_DIR=./data_store/chroma_db
CHROMA_COLLECTION_NAME=sorong_knowledge
KNOWLEDGE_DOCS_DIR=./data_store/knowledge_docs
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.55

# === Upload ===
UPLOAD_FOLDER=./static/uploads
MAX_CONTENT_LENGTH_MB=5
